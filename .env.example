# Copia este archivo a .env (NO lo subas al repositorio) y rellena los valores.

# Token del bot (BotFather)
TELEGRAM_TOKEN=
# Tu user_id numérico de Telegram (p. ej. via @userinfobot). Solo este usuario puede usar el bot.
ALLOWED_USER_ID=
# ID de la hoja: https://docs.google.com/spreadsheets/d/<ESTE_ID>/edit 
SPREADSHEET_ID=
# Contenido JSON de la cuenta de servicio en una línea, o ruta a un archivo .json
GOOGLE_SERVICE_ACCOUNT_JSON=
# Cadena aleatoria larga: secret_token del webhook y clave HMAC de los botones de borrado
WEBHOOK_SECRET=
# polling (local) | webhook (Cloud Run)
MODE=polling
# Solo en modo webhook: URL pública base (https://...run.app) y puerto
WEBHOOK_URL=
PORT=8080
TIMEZONE=Europe/Madrid
